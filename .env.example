# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke version control

# Password administrator (wajib diisi, server tidak akan jalan tanpa ini)
ADMIN_PASSWORD=GantiDenganPasswordKuat

# Port server (opsional, default: 3000)
# PORT=3000

# Folder data permanen untuk hosting. Kosongkan saat menjalankan lokal.
# DATA_DIR=/var/data
